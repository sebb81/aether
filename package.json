{
  "name": "aether",
  "productName": "AETHER",
  "version": "0.3.0",
  "private": true,
  "description": "AETHER — PRESENCE, MIND, local MEMORY and CURIOSITY",
  "author": "AETHER",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/main.cjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "package:win": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@aether/core": "*",
    "@aether/curiosity": "*",
    "@aether/mind": "*",
    "@aether/memory": "*",
    "@aether/shared": "*",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "openai": "7.28.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
